{
  "name": "obsidian-slim-bar",
  "version": "1.2.0",
  "description": "Ultra-slim Always-on-Top floating scratchpad & quick-capture bar synced directly with your Obsidian Vault.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "obsidian",
    "sticky-notes",
    "always-on-top",
    "markdown",
    "floating-bar",
    "productivity",
    "windows"
  ],
  "author": "Polliana Pavloski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QueenOverlord/obsidian-slim-bar.git"
  },
  "homepage": "https://github.com/QueenOverlord/obsidian-slim-bar#readme",
  "bugs": {
    "url": "https://github.com/QueenOverlord/obsidian-slim-bar/issues"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.keystone.obsidianslimbar",
    "productName": "Obsidian Slim Bar",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Obsidian Slim Bar",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ObsidianSlimBar-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "QueenOverlord",
        "repo": "obsidian-slim-bar",
        "releaseType": "release"
      }
    ]
  }
}
